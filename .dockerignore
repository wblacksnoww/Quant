# 构建上下文裁剪：镜像里不需要开发产物与本地密钥
.git
.gitignore
.env
.env.*
!.env.example
.venv
**/__pycache__
**/*.pyc
**/*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
frontend/node_modules
frontend/dist
frontend/.vite
data/store
data/*.db
data/master.key
backups
reports
docs
legacy
tests
src
cli
pyproject.toml
config.yaml
docker-compose*.yml
