# CODEOWNERS：PR 自动指派审查人
#
# 生效前提：仓库 Settings → Branches → 分支保护里勾选
# "Require review from Code Owners"，否则这里只是"建议"而非"强制"。
#
# 匹配规则：**最后一条匹配的规则生效**（不是第一条），所以默认规则放最上面。
# 单人开发时这些规则不会阻塞任何操作，只是标记"这块归谁"，
# 多人加入后立刻变成真实的审查分派依据。

# ---------------------------------------------------------------------------
# 默认：任何未特别指派的路径
# ---------------------------------------------------------------------------
*                                   @wblacksnoww

# ---------------------------------------------------------------------------
# 计算核心：改动风险最高，必须懂回测语义的人看
#
# 这里的代码决定"回测结论可不可信"——撮合、成本、账户、指标。
# 历史上出过的两个 P0（跳空穿仓、GTC 永久冻结资金）都在这一层。
# ---------------------------------------------------------------------------
/backend/cpp/                       @wblacksnoww
/backend/quant/execution/           @wblacksnoww
/backend/quant/core/                @wblacksnoww
/backend/quant/metrics/             @wblacksnoww
/backend/quant/risk/                @wblacksnoww
/backend/quant/engine/              @wblacksnoww

# tick 级引擎：时序与 T+1 语义最容易错，单独列出
/backend/quant/engine/tick.py       @wblacksnoww
/backend/quant/engine/tick_engine.py @wblacksnoww

# 策略表达层：spec 编译、算子、内置策略
/backend/quant/strategy/            @wblacksnoww

# ---------------------------------------------------------------------------
# C++ 交易网关：直连交易所、能真实下单，误改可能造成资金损失
# ---------------------------------------------------------------------------
/gateway/                           @wblacksnoww

# ---------------------------------------------------------------------------
# 部署与密钥：容器、反向代理、初始化脚本
#
# 这里的改动可能让所有人起不来，或者把密钥写进镜像层。
# ---------------------------------------------------------------------------
/deploy/                            @wblacksnoww
/docker-compose*.yml                @wblacksnoww
/scripts/                           @wblacksnoww
/.github/                           @wblacksnoww

# ---------------------------------------------------------------------------
# 契约文件：改动会波及前后端两侧，且 CI 会检查漂移
# ---------------------------------------------------------------------------
/frontend/src/api/schema.ts         @wblacksnoww
/frontend/src/api/openapi.json      @wblacksnoww
/backend/quant/server/schemas.py    @wblacksnoww

# ---------------------------------------------------------------------------
# 依赖锁定：升级需谨慎，CI 与生产都用同一份
# ---------------------------------------------------------------------------
/deploy/requirements.lock.txt       @wblacksnoww
/frontend/package-lock.json         @wblacksnoww

# ---------------------------------------------------------------------------
# 文档与协同规范：改动影响所有人，需要明确同意
# ---------------------------------------------------------------------------
/CONTRIBUTING.md                    @wblacksnoww
/README.md                          @wblacksnoww
/docs/                              @wblacksnoww
