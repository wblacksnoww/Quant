# ============================================================================
# Quant Terminal 环境变量模板
#
# 推荐执行 ./scripts/init-secrets.sh <域名> 自动生成本文件（含随机主密钥与管理员口令）。
# 手工复制时务必替换所有 CHANGE_ME，并保证 .env 权限为 600。
# ============================================================================

# -- 运行环境 ----------------------------------------------------------------
QUANT_ENV=production
QUANT_DEBUG=false
QUANT_APP_NAME=Quant Terminal

# -- 主密钥（必填，32 字节 base64/hex；丢失将无法解密凭据与 TOTP 种子） --------
# 生成：python3 -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
QUANT_MASTER_KEY=CHANGE_ME
# 可选：改为从文件读取主密钥（容器还可挂 Docker secret /run/secrets/quant_master_key）
#QUANT_MASTER_KEY_FILE=/run/secrets/quant_master_key

# -- 初始管理员（仅首次启动创建，之后改密码请登录或在容器内使用 CLI） --------
QUANT_ADMIN_USERNAME=admin
QUANT_ADMIN_PASSWORD=CHANGE_ME

# -- 网络与域名 --------------------------------------------------------------
# 仅 docker-compose.yml（无 Caddy）时使用的 HTTP 端口
QUANT_HTTP_PORT=8080
# docker-compose.prod.yml 使用；需提前把域名解析到服务器
QUANT_DOMAIN=localhost
# 同源部署时 CORS 实际不生效；保留给分离部署/调试使用（JSON 数组）
QUANT_ALLOWED_ORIGINS=["https://localhost"]

# -- 数据库 ------------------------------------------------------------------
# 默认 SQLite（单实例足够）；PostgreSQL 见 docker-compose.postgres.yml
QUANT_DATABASE_URL=sqlite:////app/data/quant.db
POSTGRES_DB=quant
POSTGRES_USER=quant
POSTGRES_PASSWORD=CHANGE_ME_STRONG
# 想让 docker compose 默认叠加 PostgreSQL 覆盖层，取消下面这行注释：
# COMPOSE_FILE=docker-compose.yml:docker-compose.postgres.yml

# -- 行情数据源 --------------------------------------------------------------
# akshare 免费直连；csv 读取打包的历史缓存；synthetic 仅用于链路验证
QUANT_DATA_PROVIDER=akshare
QUANT_FALLBACK_PROVIDERS=["csv"]
QUANT_DEFAULT_SYMBOLS=600519,000001,300059
# 可选：tushare token（写入数据库凭据更安全，这里仅作兼容）
TUSHARE_TOKEN=

# -- 安全策略 ----------------------------------------------------------------
QUANT_ACCESS_TOKEN_TTL=900
QUANT_REFRESH_TOKEN_TTL=604800
QUANT_LOGIN_MAX_ATTEMPTS=5
QUANT_LOGIN_LOCK_MINUTES=15
QUANT_REQUIRE_TOTP=false
QUANT_RATE_LIMIT_PER_MINUTE=120
# 回测并发上限（超出 429；默认 2）
QUANT_MAX_CONCURRENT_BACKTESTS=2
# 回测队列上限（含排队与运行中）；超出返回 429
QUANT_MAX_QUEUED_BACKTESTS=200
# 实盘总开关（默认关闭；开启后仍需在页面选择测试网/真实资金并二次确认）
QUANT_ENABLE_LIVE_TRADING=false
# 实盘轮询间隔（秒）
QUANT_LIVE_POLL_INTERVAL=5
# 实时快照缓存秒数（默认 3）。越小越实时；A 股免费源高频请求可能限流，建议 >=2；
# 以虚拟货币为主可设为 1（交易所接口限流宽松）。
QUANT_QUOTE_TTL=3
# 基础镜像（默认国内加速站；海外服务器可改为官方镜像名）
#QUANT_POSTGRES_IMAGE=postgres:16-alpine
#QUANT_CADDY_IMAGE=caddy:2.8-alpine
# 应用镜像（用 CI 产出的 GHCR 镜像时填写，配合 docker compose pull + up --no-build）
#QUANT_BACKEND_IMAGE=ghcr.io/wblacksnoww/quant-trading-backend:latest
#QUANT_FRONTEND_IMAGE=ghcr.io/wblacksnoww/quant-trading-frontend:latest
# 是否启用虚拟货币数据源（无境外出口/代理的服务器设为 false，避免行情超时）
QUANT_ENABLE_CRYPTO=true
# 虚拟货币交易所（ccxt 名称：okx / binance / gate ...）
QUANT_CRYPTO_EXCHANGE=okx
# 虚拟货币数据源代理（国外交易所直连不畅时填写）
# 宿主机直接运行：http://127.0.0.1:10808
# Docker 容器内：  http://host.docker.internal:10808（compose 已映射 host-gateway）
#QUANT_CRYPTO_PROXY=http://127.0.0.1:10808
# Secure Cookie（docker-compose.prod.yml 会自动置 true；手动开启请取消注释）
#QUANT_SECURE_COOKIES=true
